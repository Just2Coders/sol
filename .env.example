# Connection string de Neon (Dashboard → Connect → Connection string)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secreto para firmar las cookies de sesión (genera uno con: openssl rand -base64 32)
SESSION_SECRET="cambiame"

# Dominio público del sitio: base de las URLs canónicas y de Open Graph.
# En local puede omitirse (cae a http://localhost:3000).
NEXT_PUBLIC_SITE_URL="https://solaris.example"
